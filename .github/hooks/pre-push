#!/bin/sh
# Pre‑push hook that enforces release gate on pushing tags.
# Environment variable RELEASE_GATE_SKIP must equal "i-accept-red-releases" to bypass gate.
hook_dir=$(dirname $(readlink -f "$0"))
while read -r local_ref local_oid remote_ref remote_oid; do
    case "$local_ref" in
        refs/tags/v*)
            tag_name=${local_ref#refs/tags/}
            if [ -n "$RELEASE_GATE_SKIP" ] && [ "$RELEASE_GATE_SKIP" = "i-accept-red-releases" ]; then
                :
            else
                "$hook_dir/release-gate.sh" "$tag_name" "$(git rev-parse --show-toplevel)"
                if [ $? -ne 0 ]; then
                    echo "release-gate: blocked push of $tag_name" >&2
                    exit 1
                fi
            fi
            ;;
        *)
            ;;
    esac
done
exit 0
